<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.eblan.plugin.KotlinParameterSorter</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>KotlinParameterSorter</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.eblan.com">Jack Eblan</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
    Organize Kotlin function parameters with an AI-compatible chat API.
    <br><br>
    <b>Features:</b>
    <ul>
        <li>Groups related parameters with AI via Intention Action (Alt+Enter).</li>
        <li><b>Call-site support:</b> Trigger the organizer directly from where the function is used—no need to navigate to the definition.</li>
        <li><b>Project-wide updates:</b> Reorders arguments and adds matching group comments at all call sites across your entire project.</li>
        <li><b>Arrangement memory:</b> Reuses saved group names and parameter order across related functions, keeping prop-drilled APIs consistent.</li>
        <li><b>Parameter ordering:</b> The default system prompt instructs AI to keep required parameters before optional parameters and callbacks last, including final callbacks used with trailing-lambda syntax.</li>
        <li><b>Configurable AI:</b> Supports OpenAI-compatible chat-completions endpoints, models, system prompts, and API keys.</li>
    </ul>
]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.platform</depends>
    <resource-bundle>messages.KpsBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <intentionAction>
            <className>com.eblan.plugin.kps.Kps</className>
            <language>kotlin</language>
        </intentionAction>
        <!-- Persistent settings service -->
        <applicationService
                serviceImplementation="com.eblan.plugin.kps.KpsPersistentStateComponent"/>
        <applicationService
                serviceImplementation="com.eblan.plugin.kps.KpsArrangementMemory"/>

        <!-- Settings page -->
        <applicationConfigurable
                parentId="tools"
                instance="com.eblan.plugin.kps.KpsConfigurable"
                id="com.eblan.plugin.kps.KpsConfigurable"
                key="name"
                nonDefaultProject="true"/>
    </extensions>

    <!-- Declare K2 compatibility here -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

</idea-plugin>