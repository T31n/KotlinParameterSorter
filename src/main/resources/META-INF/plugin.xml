<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.eblan.plugin.KotlinParameterSorter</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>KotlinParameterSorter</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.eblan.com">Jack Eblan</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
    Automatically sort Kotlin function parameters alphabetically with a single click.
    <br><br>
    <b>Features:</b>
    <ul>
        <li>Sorts function parameters alphabetically via Intention Action (Alt+Enter).</li>
        <li><b>Call-site support:</b> Trigger the sort directly from where the function is used—no need to navigate to the definition.</li>
        <li><b>Project-wide updates:</b> Automatically reorders arguments at all call sites across your entire project.</li>
        <li><b>Compose Ready:</b> Includes customizable settings for handling <code>Modifier</code> and callback positions in @Composable functions.</li>
    </ul>
]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.platform</depends>
    <resource-bundle>messages.KpsBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <intentionAction>
            <className>com.eblan.plugin.kps.Kps</className>
            <language>kotlin</language>
        </intentionAction>
        <!-- Persistent settings service -->
        <applicationService
                serviceImplementation="com.eblan.plugin.kps.KpsPersistentStateComponent"/>

        <!-- Settings page -->
        <applicationConfigurable
                parentId="tools"
                instance="com.eblan.plugin.kps.KpsConfigurable"
                id="com.eblan.plugin.kps.KpsConfigurable"
                key="name"
                nonDefaultProject="true"/>
    </extensions>

    <!-- Declare K2 compatibility here -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <actions>
    </actions>
</idea-plugin>